AUTH_SERVER_PORT=8081

AUTH_DB_URL=jdbc:postgresql://localhost:5432/chatbox
AUTH_DB_USERNAME=chatbox
AUTH_DB_PASSWORD=chatbox

AUTH_JPA_DDL_AUTO=update
AUTH_JPA_FORMAT_SQL=true

AUTH_JWT_ISSUER=http://localhost:8081
AUTH_JWT_EXPIRATION_SECONDS=86400

# Private key RSA dung de ky JWT RS256: PKCS#8 DER -> base64 mot dong.
# Chi auth-service giu gia tri nay; cac service khac chi can public key qua JWKS.
# Tao key:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
# LUU Y buoc "pkcs8 -topk8": bo qua no thi openssl tra ve PKCS#1, va Java se bao
# "algid parse error, not a sequence" vi PKCS8EncodedKeySpec chi hieu PKCS#8.
# De trong => moi lan khoi dong sinh key tam, token cu se chet sau khi restart.
AUTH_JWT_PRIVATE_KEY=
