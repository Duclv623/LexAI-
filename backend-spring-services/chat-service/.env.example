CHAT_SERVER_PORT=8082

CHAT_DB_URL=jdbc:postgresql://localhost:5432/chatbox_chat
CHAT_DB_USERNAME=chat_service
CHAT_DB_PASSWORD=chat_service

CHAT_JPA_DDL_AUTO=update
CHAT_JPA_FORMAT_SQL=true

# JWKS cua auth-service: chat-service lay public key o day de tu verify token.
CHAT_JWKS_URI=http://localhost:8081/.well-known/jwks.json

# Dia chi cua ai-service. CHAT-SERVICE goi THANG vao day, khong vong qua gateway:
# day la giao tiep noi bo giua hai service (east-west), khong phai traffic tu ngoai vao.
CHAT_AI_BASE_URL=http://localhost:8000
CHAT_AI_TIMEOUT_SECONDS=90
