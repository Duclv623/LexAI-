# Bien duoc Docker Compose doc tu file .env o thu muc goc.
NEXT_PUBLIC_API_URL=http://localhost:8080
LLM_MODEL_NAME=gemini-3.5-flash-lite
HF_HUB_OFFLINE=0

# De trong thi auth-service sinh khoa RSA tam moi khi container khoi dong lai.
AUTH_JWT_PRIVATE_KEY=openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0


# GOOGLE_API_KEY dat trong AIservice/.env (copy tu AIservice/.env.example).
